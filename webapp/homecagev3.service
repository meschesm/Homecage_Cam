[Unit]
Description=homecagev3 web app
After=network.target

[Service]
User=ab-ivnc
Group=ab-ivnc
WorkingDirectory=/home/ab-ivnc/homecagev3/webapp
Environment="PATH=/home/ab-ivnc/homecagev3/venv/bin:/usr/bin:/bin"
EnvironmentFile=/home/ab-ivnc/homecagev3/.env
ExecStart=/home/ab-ivnc/homecagev3/venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
